<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0">
  
  <info>
    <title>Custom Vancouver No Title Bold Year</title>
    <id>http://www.zotero.org/styles/custom-vancouver-no-title</id>
    <link href="http://www.zotero.org/styles/vancouver" rel="independent-parent"/>
    <category citation-format="numeric"/>
    <updated>2026-04-28</updated>
  </info>

  <!-- CITAS EN SUPERÍNDICE -->
  <citation collapse="citation-number">
    <layout vertical-align="sup">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- BIBLIOGRAFÍA -->
  <bibliography>
    <layout suffix=".">
      
      <text variable="citation-number" suffix=". "/>

      <names variable="author" delimiter=", " et-al-min="2" et-al-use-first="1">
        <name form="short"/>
        <et-al font-style="italic"/>
      </names>
      <text value=". "/>

      <!-- Revista abreviada en cursiva -->
      <text variable="container-title" form="short" font-style="italic"/>
      <text value=" "/>

      <!-- Año en negrita (CORRECTO) -->
      <date variable="issued" font-weight="bold">
        <date-part name="year"/>
      </date>

      <text value=", "/>
      <text variable="volume"/>
      <text value="("/>
      <text variable="issue"/>
      <text value="), "/>
      <text variable="page"/>

    </layout>
  </bibliography>

</style>
